{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with daily caloric and macronutrient goals and active plan pointer",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "activePlanId": { "type": "string", "maxLength": 128 },
        "goals": {
          "type": "object",
          "properties": {
            "kcal": { "type": "number" },
            "proteinPct": { "type": "number" },
            "carbsPct": { "type": "number" },
            "fatPct": { "type": "number" },
            "targetWeightKg": { "type": "number" }
          },
          "required": ["kcal", "proteinPct", "carbsPct", "fatPct", "targetWeightKg"]
        }
      },
      "required": ["uid", "goals"]
    },
    "SharedPlan": {
      "title": "SharedPlan",
      "description": "Shared meal plan document allowing multi-account collaboration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "shareCode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "members"]
    },
    "ShareCode": {
      "title": "ShareCode",
      "description": "Code enabling other accounts to link to a shared plan",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "planId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "planId", "ownerUid"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Saved recipe with ingredients, instructions and nutritional details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 4096 },
        "prepTimeMin": { "type": "number" },
        "mealTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ingredients": {
          "type": "array"
        },
        "createdAt": { "type": "string" },
        "pochodzenie": { "type": "string", "maxLength": 512 },
        "czyUlubiony": { "type": "boolean" }
      },
      "required": ["id", "name", "prepTimeMin", "mealTypes", "ingredients"]
    },
    "DayPlan": {
      "title": "DayPlan",
      "description": "Daily scheduled meals for breakfast, morning snack, lunch, and dinner",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "meals": { "type": "object" }
      },
      "required": ["date", "meals"]
    },
    "WeightEntry": {
      "title": "WeightEntry",
      "description": "Daily body weight entry in kilograms",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "weightKg": { "type": "number" }
      },
      "required": ["date", "weightKg"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile and diet parameters"
    },
    "/users/{userId}/recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/Recipe" },
      "description": "Stores individual recipes belonging to the user"
    },
    "/users/{userId}/mealPlans/{date}": {
      "schema": { "$ref": "#/entities/DayPlan" },
      "description": "Stores daily meal plans for a specific date"
    },
    "/users/{userId}/weightLogs/{date}": {
      "schema": { "$ref": "#/entities/WeightEntry" },
      "description": "Stores weight measurements for a specific date"
    },
    "/plans/{planId}": {
      "schema": { "$ref": "#/entities/SharedPlan" },
      "description": "Shared meal plan record allowing multi-user collaboration"
    },
    "/plans/{planId}/mealPlans/{date}": {
      "schema": { "$ref": "#/entities/DayPlan" },
      "description": "Shared daily meal plans for collaborative users"
    },
    "/plans/{planId}/recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/Recipe" },
      "description": "Shared recipes for collaborative users"
    },
    "/shareCodes/{code}": {
      "schema": { "$ref": "#/entities/ShareCode" },
      "description": "Lookup registry for plan sharing invitation codes"
    }
  }
}
