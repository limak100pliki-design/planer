rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidDate(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // User Profile, Personal Settings & Weight Logs
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      // User's custom recipes (personal fallback)
      match /recipes/{recipeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(recipeId);
      }

      // User's scheduled meal plans (personal fallback)
      match /mealPlans/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDate(date);
      }

      // User's weight logs (accessible to signed-in collaborators for shared accounts)
      match /weightLogs/{date} {
        allow read: if isSignedIn();
        allow delete: if isSignedIn();
        allow create, update: if isSignedIn() && isValidDate(date);
      }

      // User's blood glucose logs (accessible to signed-in collaborators for shared accounts)
      match /glucoseLogs/{logId} {
        allow read: if isSignedIn();
        allow delete: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(logId);
      }

      // User's personal shopping list fallback
      match /shopping/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }
    }

    function isPlanCollaborator(planId) {
      return isSignedIn() && (
        request.auth.uid == planId ||
        (exists(/databases/$(database)/documents/plans/$(planId)) && (
          request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId ||
          (get(/databases/$(database)/documents/plans/$(planId)).data.members is list &&
           request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.members)
        ))
      );
    }

    // Shared Plans (allows multiple accounts to collaborate on the same meal plan)
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.auth.uid == planId
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.members ||
        request.auth.uid in request.resource.data.members
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      // Collaborative Meal Plans for this plan
      match /mealPlans/{date} {
        allow read: if isSignedIn();
        allow create, update: if isPlanCollaborator(planId) && isValidDate(date);
        allow delete: if isPlanCollaborator(planId);
      }

      // Collaborative Recipes for this plan
      match /recipes/{recipeId} {
        allow read: if isSignedIn();
        allow create, update: if isPlanCollaborator(planId) && isValidId(recipeId);
        allow delete: if isPlanCollaborator(planId);
      }

      // Collaborative Shopping List for this plan
      match /shopping/{docId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isPlanCollaborator(planId) && isValidId(docId);
      }
    }

    // Share code registry to pair and join shared meal plans
    match /shareCodes/{code} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
